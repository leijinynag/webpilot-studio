{
  "name": "webpilot-studio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "start": "next start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate-database.ts",
    "db:smoke": "vitest run --config vitest.database.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "NODE_ENV=test vitest run",
    "test:infrastructure": "vitest run --config vitest.infrastructure.config.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:preview": "playwright test tests/e2e/preview-deployment.spec.ts --workers=1"
  },
  "dependencies": {
    "@isomorphic-git/lightning-fs": "4.6.2",
    "@monaco-editor/react": "4.7.0",
    "@neondatabase/serverless": "1.1.0",
    "@vercel/blob": "2.6.1",
    "@webcontainer/api": "1.6.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "fflate": "^0.8.3",
    "isomorphic-git": "1.36.2",
    "lucide-react": "1.26.0",
    "monaco-editor": "0.52.2",
    "next": "16.2.11",
    "next-intl": "^4.13.4",
    "radix-ui": "1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "ws": "8.21.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@playwright/test": "1.62.0",
    "@rsbuild/core": "2.1.8",
    "@rsbuild/plugin-react": "2.1.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "20.19.43",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.0.4",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "eslint-config-prettier": "10.1.8",
    "fake-indexeddb": "6.2.4",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.14.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
