# Public application URL exposed to browser bundles.
NEXT_PUBLIC_SITE_URL=

# Primary persistence and object storage.
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=

# Signs the anonymous owner cookie. Production requires at least 32 characters.
ANON_SESSION_SECRET=

# Agent language model provider.
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_AGENT_MODEL=deepseek-v4-pro
LLM_FAST_MODEL=deepseek-v4-flash
# 长对话 ContextCheckpoint 使用的摘要模型；为空时回退 LLM_FAST_MODEL。
LLM_SUMMARY_MODEL=
# Monaco 行内补全模型；为空时回退 LLM_FAST_MODEL。
CODE_COMPLETION_MODEL=

# Visual understanding provider.
VISION_PROVIDER=
VISION_API_KEY=
VISION_MODEL=
# 图片理解请求超时时间，带推理的视觉模型建议至少保留 60 秒。
VISION_TIMEOUT_MS=60000

# Image generation provider.
IMAGE_PROVIDER=
IMAGE_API_KEY=
IMAGE_MODEL=

# Durable job queue and rate-limit storage.
QUEUE_URL=
QUEUE_TOKEN=
REDIS_URL=
REDIS_TOKEN=
# 生产环境默认要求 Redis 限流配置完整；本地可留空，额度服务会使用 PostgreSQL 兼容实现。
RATE_LIMIT_REDIS_REQUIRED=true

# Showcase publishing boundary.
SHOWCASE_ADMIN_TOKEN=
SHOWCASE_ORIGIN=
SHOWCASE_PARENT_ORIGIN=
# 第二个 Vercel Project 使用 true，仅暴露 /showcase/runtime 和 Next 静态资源。
SHOWCASE_RUNTIME_ONLY=

# Feature switches. Use "true" or "false".
AGENT_ENABLED=true
IMAGE_GENERATION_ENABLED=
ATTACHMENT_UPLOAD_ENABLED=

# Anonymous usage and cost limits.
ANON_RUNS_PER_IP_PER_DAY=
ANON_RUNS_PER_OWNER_PER_DAY=
MAX_CONCURRENT_RUNS_PER_OWNER=
MAX_GLOBAL_AGENT_RUNS=
ANON_IMAGE_RUNS_PER_IP_PER_DAY=
ANON_IMAGE_RUNS_PER_OWNER_PER_DAY=
MAX_CONCURRENT_IMAGE_RUNS_PER_OWNER=
MAX_GLOBAL_IMAGE_RUNS=
ANON_ATTACHMENTS_PER_IP_PER_DAY=
ANON_ATTACHMENTS_PER_OWNER_PER_DAY=
MAX_CONCURRENT_UPLOADS_PER_OWNER=
# 以下预算只在创建新 Run 时冻结；修改配置不会改变已经存在的 Run。
# 默认不设置固定模型轮次上限；仅在需要紧急硬保护时填写正整数。
MAX_AGENT_MODEL_TURNS=
# 默认 512 次源码文件 mutation，支持大型项目的多文件创建与迭代。
MAX_AGENT_FILE_MUTATIONS=
# 默认 1800 秒有效执行时间；等待浏览器工具和异步任务不计入该时长。
MAX_AGENT_WALL_TIME_SECONDS=
MAX_GLOBAL_DAILY_COST_USD=
# 当 MAX_GLOBAL_DAILY_COST_USD 配置后，以下价格也必须配置，否则服务会拒绝
# 新的模型/生图调用，避免把未知成本当作 0 美元放行。
LLM_INPUT_COST_PER_1M_USD=
LLM_OUTPUT_COST_PER_1M_USD=
VISION_INPUT_COST_PER_1M_USD=
VISION_OUTPUT_COST_PER_1M_USD=
IMAGE_COST_PER_GENERATION_USD=
