# Public application URL exposed to browser bundles.
NEXT_PUBLIC_SITE_URL=

# Primary persistence and object storage.
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=

# Signs the anonymous owner cookie. Production requires at least 32 characters.
ANON_SESSION_SECRET=

# Agent language model provider.
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_AGENT_MODEL=deepseek-v4-pro
LLM_FAST_MODEL=deepseek-v4-flash

# Visual understanding provider.
VISION_PROVIDER=
VISION_API_KEY=
VISION_MODEL=

# Image generation provider.
IMAGE_PROVIDER=
IMAGE_API_KEY=
IMAGE_MODEL=

# Durable job queue and rate-limit storage.
QUEUE_URL=
QUEUE_TOKEN=
REDIS_URL=
REDIS_TOKEN=

# Showcase publishing boundary.
SHOWCASE_ADMIN_TOKEN=
SHOWCASE_ORIGIN=

# Feature switches. Use "true" or "false".
AGENT_ENABLED=true
IMAGE_GENERATION_ENABLED=
ATTACHMENT_UPLOAD_ENABLED=

# Anonymous usage and cost limits.
ANON_RUNS_PER_IP_PER_DAY=
ANON_RUNS_PER_OWNER_PER_DAY=
MAX_CONCURRENT_RUNS_PER_OWNER=
MAX_GLOBAL_AGENT_RUNS=
MAX_AGENT_MODEL_TURNS=
MAX_AGENT_WALL_TIME_SECONDS=
MAX_GLOBAL_DAILY_COST_USD=
